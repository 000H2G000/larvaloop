NODE_ENV=development
PORT=4000

MONGODB_URI=mongodb://127.0.0.1:27017/acorn2protein

JWT_SECRET=replace_with_secure_secret
JWT_EXPIRES_IN=1d

FASTAPI_BASE_URL=http://localhost:8000
FASTAPI_TIMEOUT_MS=15000

UPLOAD_DIR=uploads
UPLOAD_MAX_MB=10

CORS_ORIGIN=http://localhost:3000

DEVICE_API_KEY_SECRET=replace_with_secure_secret

SOCKET_CORS_ORIGIN=http://localhost:3000

# Optional
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
DEVICE_RATE_LIMIT_PER_MIN=60

# Alert thresholds (defaults match the ESP32 firmware)
TEMP_WARNING_C=28
TEMP_CRITICAL_C=30
TEMP_HYSTERESIS_C=1
HUMIDITY_MIN_PCT=40
HUMIDITY_MAX_PCT=80
HUMIDITY_HYSTERESIS_PCT=2
DEVICE_OFFLINE_AFTER_S=30
