# Base URL of the ACORN2PROTEIN backend REST API (must be allowed by the backend's CORS_ORIGIN).
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Server-only: /api/readings compatibility route for firmware that posts to :3000 without auth headers
BACKEND_INTERNAL_URL=http://localhost:4000/api/v1
# deviceId:apiKey pairs from `npm run device:register` in the backend
LEGACY_DEVICE_KEYS=ESP32_TRAY_01:replace_with_device_key
